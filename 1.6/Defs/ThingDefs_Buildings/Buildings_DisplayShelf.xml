	<ThingDef ParentName="sbzDisplayShelfBase">
		<defName>sbz_OpenShelf</defName>
		<label>open shelf</label>
		<description>A open shelf that can store up to 12 items of various kinds.</description>
		<graphicData>
			<texPath>Things/Building/Storage/OpenShelf/sbz_OpenShelf</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawRotated>false</drawRotated>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Storage/OpenShelf/sbz_OpenShelfUI</uiIconPath>
		<uiIconScale>1.6</uiIconScale>		
		<rotatable>true</rotatable>
		<costStuffCount>40</costStuffCount>
		<uiOrder>990</uiOrder>
		<staticSunShadowHeight>0.3</staticSunShadowHeight>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>6</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Foods</li>
						<li>Manufactured</li>
						<li>ResourcesRaw</li>
						<li>Items</li>
						<li>Weapons</li>
						<li>Apparel</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
	</ThingDef>

