<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--display table-->
    <AdaptiveStorage.GraphicsDef>
		<defName>sbz_DisplayTableASF</defName>
		<targetDef>sbz_DisplayTable</targetDef>
        <graphics>
            <li>
                <graphicData>
                    <texPath>Things/Building/Storage/DisplayTable/sbz_DisplayTable</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(4,4)</drawSize>
					<drawRotated>false</drawRotated>
                </graphicData>
				<graphicDatas>
					<li>
						<texPath>Things/Building/Storage/DisplayTable/sbz_DisplayTableLayer</texPath>
						<graphicClass>Graphic_Single</graphicClass>
						<shaderType>CutoutComplex</shaderType>
						<drawSize>(4,4)</drawSize>
						<drawRotated>false</drawRotated>
						<renderQueue>2950</renderQueue>
						<altitudeLayer>ItemImportant</altitudeLayer>
						<drawOffset>(0,1.2,0)</drawOffset>
					</li>
				</graphicDatas>
            </li>
        </graphics>
		<showContainedItems>true</showContainedItems>
		<itemGraphics>
			<columns>
				<c0>
					<rows>
						<r0>
							<stackBehaviour>Stack</stackBehaviour>
							<stackOffset>(0,0,0)</stackOffset>
							<drawOffset>(0,0,0.35)</drawOffset>
							<drawScale>0.8</drawScale>
							<rotation>0</rotation>
						</r0>
					</rows>
				</c0>
			</columns>
		</itemGraphics>
	</AdaptiveStorage.GraphicsDef>

	<ThingDef ParentName="sbzSmallDisplayShelfBase">
		<defName>sbz_DisplayTable</defName>
		<label>display case</label>
		<description>A display case that can showcase up to 1 item.</description>
		<graphicData>
			<texPath>Things/Building/Storage/DisplayTable/sbz_DisplayTable</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawRotated>false</drawRotated>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Storage/DisplayTable/sbz_DisplayTableUI</uiIconPath>
		<uiIconScale>1.6</uiIconScale>		
		<rotatable>false</rotatable>
		<costStuffCount>10</costStuffCount>
		<uiOrder>1075</uiOrder>
		<staticSunShadowHeight>0.25</staticSunShadowHeight>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>false</ignoreStoredThingsBeauty>
			<maxItemsInCell>1</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Foods</li>
						<li>Manufactured</li>
						<li>ResourcesRaw</li>
						<li>Items</li>
						<li>Weapons</li>
						<li>Apparel</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
		<statBases>
			<Beauty>20</Beauty>
		</statBases>
		<comps>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtFurniture</nameMaker>
				<descriptionMaker>ArtDescription_Furniture</descriptionMaker>
				<canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
			</li>
		</comps>
	</ThingDef>

