<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--corpse spot-->
    <AdaptiveStorage.GraphicsDef>
		<defName>sbz_CorpseSpotASF</defName>
		<targetDef>sbz_CorpseSpot</targetDef>
        <graphics>
            <li>
                <graphicData>
                    <texPath>Things/Building/Storage/sbz_CorpseSpot</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>(1,1)</drawSize>
                </graphicData>
            </li>
        </graphics>
		<showContainedItems>true</showContainedItems>
		<itemGraphics>
			<columns>
				<c0>
					<rows>
						<r0>
							<stackBehaviour>Circle</stackBehaviour>
							<drawScale>1</drawScale>
						</r0>
					</rows>
				</c0>
			</columns>
		</itemGraphics>
	</AdaptiveStorage.GraphicsDef>
	
	<ThingDef ParentName="AdaptiveStorageBase">
		<defName>sbz_CorpseSpot</defName>
		<label>corpse dump spot</label>
		<description>A spot that can store up to 12 corpses.</description>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<rotatable>true</rotatable>
		<passability>Standable</passability>
		<statBases>
			<WorkToBuild>1</WorkToBuild>
		</statBases>
		<fillPercent>0</fillPercent>
		<useHitPoints>false</useHitPoints>
		<size>(1,1)</size>
		<surfaceType>Item</surfaceType>
		<graphicData>
			<texPath>Things/Building/Storage/sbz_CorpseSpot</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
			<color>(155,155,155)</color>
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<uiOrder>950</uiOrder>
		<building>
			<preventDeteriorationOnTop>false</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>false</ignoreStoredThingsBeauty>
			<maxItemsInCell>12</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Corpses</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
	</ThingDef>

</Defs>